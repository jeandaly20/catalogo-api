# Copie este archivo como .env y reemplace los valores. No suba .env al repositorio.

# Servidor
PORT=3000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalogo_db
DB_USER=postgres
DB_PASSWORD=

# JWT (use una cadena larga y aleatoria)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Administrador inicial (lo crea: npm run crear-admin)
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@catalogo.test
ADMIN_PASSWORD=
